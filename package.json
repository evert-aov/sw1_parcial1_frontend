{
  "name": "frontend",
  "version": "1.0.0",
  "description": "Diagramador UML interactivo",
  "author": {
    "name": "Diagramador Team",
    "email": "diagramador@uagrm.edu.bo"
  },
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:electron": "ng build --configuration electron-local --base-href ./",
    "build:electron:local": "ng build --configuration electron-local --base-href ./",
    "build:electron:prod": "ng build --configuration electron-prod --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:start": "npm run build:electron && electron .",
    "electron:nix": "nix-shell --run 'electron .'",
    "electron:dev:nix": "nix-shell --run 'electron . --dev'",
    "electron:start:nix": "nix-shell --run 'npm run build:electron && electron .'",
    "dist:linux": "npm run build:electron && electron-builder --linux AppImage",
    "dist:linux:prod": "npm run build:electron:prod && electron-builder --linux AppImage",
    "dist:linux:nix": "nix-shell --run 'npm run dist:linux'",
    "dist:linux:prod:nix": "nix-shell --run 'npm run dist:linux:prod'",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "appimage:run": "nix-shell -p appimage-run --run \"appimage-run 'release/Diagramador UML-1.0.0.AppImage'\"",
    "check:architecture": "node scripts/check-plugin-boundaries.mjs",
    "prebuild": "npm run check:architecture",
    "test:architecture": "node --test scripts/check-plugin-boundaries.spec.mjs",
    "pretest": "npm run test:architecture && npm run check:architecture"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@foblex/2d": "^1.2.2",
    "@foblex/flow": "^19.1.6",
    "@foblex/mediator": "^1.1.3",
    "@foblex/platform": "^1.0.4",
    "@foblex/utils": "^1.1.1",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/heroicons": "^35.0.1",
    "fast-xml-parser": "^5.11.1",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/jszip": "^3.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.uagrm.diagramador",
    "productName": "UML ER Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "dist/frontend/browser/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!**/.bin/**",
          "!**/*.map"
        ]
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "diagramador@uagrm.edu.bo"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
